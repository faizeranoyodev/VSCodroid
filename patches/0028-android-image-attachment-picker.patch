+	private async pickAndroidImages(options: IOpenDialogOptions, targetWindow: Window, extensions: string[]): Promise<URI[] | undefined> {
+		const files = await new Promise<File[]>((resolve) => {
+			const input = targetWindow.document.createElement('input');
+			input.type = 'file';
+			input.accept = extensions.map(extension => `.${extension}`).join(',');
+			input.multiple = !!options.canSelectMany;
+			input.hidden = true;
+			const finish = () => {
+				resolve(Array.from(input.files ?? []));
+				input.remove();
+			};
+			input.addEventListener('change', finish, { once: true });
+			input.addEventListener('cancel', finish, { once: true });
+			targetWindow.document.body.appendChild(input);
+			input.click();
+		});
+		if (!files.length) {
+			return undefined;
+		}
+		if (files.some(file => file.size > 20 * 1024 * 1024)) {
+			throw new Error('Android attachments must be 20 MB or smaller');
+		}
+		// Store through the remote provider so extensions can read the returned
+		// URIs. A content:// URI or browser-only blob cannot be read by Node.
+		const directory = joinPath(await this.preferredHome(Schemas.vscodeRemote), '.vscodroid', 'attachments', targetWindow.crypto.randomUUID());
+		await this.fileService.createFolder(directory);
+		try {
+			const result: URI[] = [];
+			for (let index = 0; index < files.length; index++) {
+				const file = files[index];
+				const name = file.name.replace(/[^a-zA-Z0-9._-]/g, '_') || 'image.png';
+				const uri = joinPath(directory, `${index}-${name}`);
+				await this.fileService.writeFile(uri, VSBuffer.wrap(new Uint8Array(await file.arrayBuffer())));
+				result.push(uri);
+			}
+			return result;
+		} catch (error) {
+			await this.fileService.del(directory, { recursive: true }).catch(() => undefined);
+			throw error;
+		}
 	}
 
